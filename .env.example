# Template for a fresh clone: copy to .env and fill in.
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env
# Only OPENAI_API_KEY is strictly required. Everything else has a working default.

OPENAI_API_KEY=

OPENAI_MODEL_PRIMARY=gpt-5-mini
OPENAI_MODEL_FALLBACK=gpt-5-nano

# Optional, free from an NCBI account. Raises PubMed from 3 to 10 req/s.
NCBI_API_KEY=

# E-utilities asks callers to identify themselves on every request.
NCBI_TOOL=biomed-mcp
NCBI_EMAIL=

# Optional, free. Raises Semantic Scholar rate limits.
SEMANTIC_SCHOLAR_API_KEY=

DB_PATH=./data/app.db
CACHE_TTL_SECONDS=86400

MAX_AGENT_STEPS=8
SESSION_TOKEN_BUDGET=60000
COMPACTION_TRIGGER_TOKENS=8000
